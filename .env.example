# Copy this file to .env and fill in the values. Never commit .env.

# Long random string used to sign login sessions (required).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Supabase project settings -> API (used for login and sign-up).
# The newer "publishable" key also works here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Public URL of this app, used in verification and reset-email links (no trailing slash).
# Locally: http://localhost:5000   On Vercel: https://<your-app>.vercel.app
SITE_URL=http://localhost:5000

# "development" or "production" (app-level flag read by app/config.py).
FLASK_ENV=

# Set to 1 locally for the debugger and auto-reload.
FLASK_DEBUG=
