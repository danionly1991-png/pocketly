# Copy this file to .env and fill in the values. Never commit .env.

# Long random string used to sign sessions (required from Spec 02 on).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Supabase project settings -> API. Not used yet in Part 1.
# The newer "publishable" key also works here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# "development" or "production" (app-level flag read by app/config.py).
FLASK_ENV=

# Set to 1 locally for the debugger and auto-reload.
FLASK_DEBUG=
